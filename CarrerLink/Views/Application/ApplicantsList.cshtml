@model IEnumerable<CarrerLink.Models.Application>
@Html.AntiForgeryToken()

@{
    ViewData["Title"] = "Applicants List";
}

<h2 class="mt-4 mb-3">Applicants for this Job</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No applicants have applied for this job yet.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-primary">
            <tr>s
                <th>Photo</th>
                <th>Applicant Name</th>
                <th>Email</th>
                <th>Skills</th>
                <th>Experience</th>
                <th>Education</th>
                <th>Resume</th>
                <th>Applied Date</th>
                <th>Status</th>
                <th>Change Status</th>
                <th>Send Message</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in Model)
            {
                var applicant = app.Applicant;
                var user = applicant?.User;

                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(applicant?.ProfilePicturePath))
                        {
                            <img src="@Url.Content(applicant.ProfilePicturePath)" alt="Profile Picture"
                                 width="50" height="50" style="object-fit:cover;border-radius:50%;" />
                        }
                        else
                        {
                            <span class="text-muted">No Photo</span>
                        }
                    </td>
                    <td>@user?.Name</td>
                    <td>@user?.Email</td>
                    <td>@applicant?.Skills</td>
                    <td>@applicant?.Experience</td>
                    <td>@applicant?.Education</td>
                    <td>
                        @if (!string.IsNullOrEmpty(applicant?.ResumePath))
                        {
                            <a href="@Url.Content(applicant.ResumePath)" target="_blank" class="btn btn-sm btn-outline-primary">
                                View Resume
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">No Resume</span>
                        }
                    </td>
                    <td>@app.AppliedAt.ToString("yyyy-MM-dd")</td>
                    <td id="status-@app.ApplicationId">@app.Status</td>
                    <td>
                        <form asp-action="UpdateStatus" asp-controller="Application" method="post" style="display:inline;">
                            <input type="hidden" name="applicationId" value="@app.ApplicationId" />

                            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="Pending" selected="@(app.Status == "Pending")">Pending</option>
                                <option value="ShortListed" selected="@(app.Status == "ShortListeded")">ShortListed</option>
                                <option value="Reviewed" selected="@(app.Status == "Reviewed")">Reviewed</option>
                                <option value="Accepted" selected="@(app.Status == "Accepted")">Accepted</option>
                                <option value="Rejected" selected="@(app.Status == "Rejected")">Rejected</option>
                            </select>
                        </form>
                    </td>
                    <td>
                        <a asp-controller="Message" asp-action="Create" asp-route-ApplicantId="@applicant.ApplicantId" class="btn btn-primary btn-sm">Send Message</a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
}

<script>
    document.querySelectorAll('select[name="status"]').forEach(select => {
        select.addEventListener('change', async e => {
            const form = e.target.closest('form');
            const data = new FormData(form);
            await fetch(form.action, {
                method: 'POST',
                body: data
            });
        });
    });
</script>

