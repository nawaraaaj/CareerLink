
@model IEnumerable<CarrerLink.Models.Job>

@{
    ViewData["Title"] = "Home Page";

    var userName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Guest";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "No Role";
    var userId = User.FindFirst("UserId")?.Value ?? "No UserId";
}
@{
    var availableJobs = Model.Where(j => j.ApplicationDeadline >= DateTime.Now).ToList();
    var expiredJobs = Model.Where(j => j.ApplicationDeadline < DateTime.Now).ToList();
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h2>Welcome, @userName!</h2>
        <p>Your role: <strong>@userRole</strong></p>

        @if (User.IsInRole("Admin"))
        {
            <p class="text-danger">You have admin privileges.</p>
        }
        else if (User.IsInRole("Applicant"))
        {
            <p class="text-primary">You can apply for jobs.</p>
        }
        else if (User.IsInRole("Recruiter"))
        {
            <p class="text-success">You can post jobs.</p>
        }
    </div>
    <div class="container mt-4">
        <h2 class="text-center mb-4">Find Your Next Job</h2>

        <!-- Search Form -->
        <form asp-controller="Home" asp-action="Index" method="get" class="row g-2 justify-content-center mb-4">
            <div class="col-md-4">
                <input type="text" name="keyword" class="form-control"
                       placeholder="Search by title, company, or location"
                       value="@Context.Request.Query["keyword"]" />
            </div>

            <div class="col-md-3">
                <select name="jobType" class="form-select">
                    <option value="">All Job Types</option>
                    @if (ViewBag.JobTypes != null)
                    {
                        foreach (var type in ViewBag.JobTypes as List<string>)
                        {
                            <option value="@type" selected="@(type == Context.Request.Query["jobType"])">@type</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </form>

         <!-- Job Sections -->
    @if (Model.Any())
    {
       

        <!-- Available Jobs -->
        <h4 class="mb-3 text-success fw-bold border-bottom pb-2">Available Jobs</h4>
        @if (availableJobs.Any())
        {
            <div class="row">
                @foreach (var job in availableJobs)
                {
                    @await Html.PartialAsync("_JobCard", job)
                }
            </div>
        }
        else
        {
            <p class="text-muted">No currently available jobs.</p>
        }

        <!-- Expired Jobs -->
        <h4 class="mt-5 mb-3 text-danger fw-bold border-bottom pb-2">Expired Jobs</h4>
        @if (expiredJobs.Any())
        {
            <div class="row">
                @foreach (var job in expiredJobs)
                {
                    @await Html.PartialAsync("_JobCard", job)
                }
            </div>
        }
        else
        {
            <p class="text-muted">No expired jobs.</p>
        }
    }
    else
    {
        <div class="text-center text-muted mt-4">
            <i class="bi bi-search fs-1"></i>
            <p class="mt-2">No jobs found matching your search criteria.</p>
        </div>
    }
</div>
    


    <!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
        <nav aria-label="Job pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { keyword = Context.Request.Query["keyword"], jobType = Context.Request.Query["jobType"], page = ViewBag.CurrentPage - 1 })">Previous</a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { keyword = Context.Request.Query["keyword"], jobType = Context.Request.Query["jobType"], page = i })">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { keyword = Context.Request.Query["keyword"], jobType = Context.Request.Query["jobType"], page = ViewBag.CurrentPage + 1 })">Next</a>
                </li>
            </ul>
        </nav>
}


    
