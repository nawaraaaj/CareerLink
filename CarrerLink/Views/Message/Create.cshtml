@model CarrerLink.Models.MessageViewModel

<h3>Send Message to @ViewBag.ApplicantName</h3>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <strong>SUCCESS:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<form asp-action="Create" method="post" id="messageForm">
    @Html.AntiForgeryToken()

    <div class="form-group mb-3">
        <label class="form-label">To Applicant</label>
        <input type="text" value="@ViewBag.ApplicantName" class="form-control" readonly />
        <input type="hidden" asp-for="ApplicantId" />
        <span asp-validation-for="ApplicantId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Content" class="form-label"></label>
        <textarea asp-for="Content" class="form-control" rows="4" placeholder="Type your message here..."></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Send Message</button>
    <a href="javascript:history.back()" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                document.getElementById('messageForm').reset();
            }
        });
    </script>
}