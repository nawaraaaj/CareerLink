
@model CarrerLink.Models.Job

@{
    var remainingDays = (Model.ApplicationDeadline - DateTime.Now).Days;
}

<div class="col-md-3 mb-4">
    <div class="card job-card shadow-sm border-0 rounded-3 h-100">
        <div class="card-body d-flex flex-column">
            <h5 class="card-title fw-bold">@Model.Title</h5>

            <h6 class="card-subtitle mb-2 text-muted">
                <a asp-controller="Recruiter" asp-action="Profile" asp-route-id="@Model.RecruiterId"
                   class="text-decoration-none">
                    @Model.Recruiter?.User?.Name
                </a>
            </h6>

            <p class="mb-1">
                <i class="bi bi-geo-alt"></i> @Model.Location
                <span class="badge bg-primary ms-2">@Model.JobType</span>
            </p>

            <p class="text-muted mb-1">
                <i class="bi bi-clock"></i> Posted @Model.PostedDate.ToString("MMM dd, yyyy")
            </p>

            @if (remainingDays > 3)
            {
                <p class="text-muted mb-1">@($"{remainingDays} days left")</p>
            }
            else if (remainingDays > 0)
            {
                <p class="text-danger fw-bold mb-1">@($"{remainingDays} days left!")</p>
            }
            else
            {
                <p class="text-danger mb-1">Deadline passed</p>
            }

            @if (Model.Salary > 0)
            {
                <p class="text-success fw-semibold">NRs. @Model.Salary.ToString("N0")</p>
            }

            <div class="mt-auto">
                <a asp-controller="Job" asp-action="Details" asp-route-id="@Model.JobId"
                   class="btn btn-sm btn-outline-primary w-100 mb-2">View Details</a>

                @if (User.IsInRole("Applicant"))
                {
                    <a asp-controller="Application" asp-action="Apply" asp-route-id="@Model.JobId"
                       class="btn btn-sm btn-success w-100">Apply Now</a>
                }
                else if (User.IsInRole("Recruiter") &&
                Model.Recruiter?.UserId == int.Parse(User.FindFirst("UserId")?.Value ?? "0"))
                {
                    <div class="d-flex gap-2">
                        <a asp-controller="Job" asp-action="Edit" asp-route-id="@Model.JobId"
                           class="btn btn-sm btn-warning flex-fill">Edit</a>
                        <a asp-controller="Job" asp-action="Delete" asp-route-id="@Model.JobId"
                           class="btn btn-sm btn-danger flex-fill">Delete</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .job-card {
        transition: all 0.2s ease-in-out;
    }

        .job-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }
</style>
